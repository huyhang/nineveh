# Absolute NAS paths. The data path contains the library directories.
NINEVEH_DATA_PATH=/volume1/media/nineveh
NINEVEH_STATE_PATH=/volume1/docker/nineveh/state
NINEVEH_SECRETS_PATH=/volume1/docker/nineveh/secrets

# Use the UID/GID that owns the state directory and can read the media directory.
NINEVEH_PUID=1026
NINEVEH_PGID=100

NINEVEH_PORT=8080
NINEVEH_ADMIN_USERNAME=admin
NINEVEH_ADMIN_PASSWORD_FILE=/run/secrets/admin_password.txt
NINEVEH_SECURE_COOKIES=true

# The origin browsers and OPDS clients actually reach, scheme included. Every
# OPDS link is stamped with it, and browser logins are only accepted from it.
# Behind a reverse proxy this is not optional: the proxy terminates TLS, so
# Nineveh cannot infer the https:// origin on its own and both feed links and
# sign-in break. Deployment-owned and not editable in the admin UI, because a
# wrong value locks you out of the page that would fix it.
NINEVEH_PUBLIC_BASE_URL=https://nineveh.example.com

# Peers whose X-Forwarded-* headers are believed; accepts an address, a
# comma-separated list, or CIDR. Docker's port mapping rewrites the source
# address, so a DSM proxy pointed at 127.0.0.1:8080 does NOT arrive from
# 127.0.0.1 and this default silently discards its X-Forwarded-Proto.
# Do not guess the subnet -- Compose uses its own network, not the default
# bridge. The deployment guide shows how to read the real address:
# docker/synology-deployment.md#finding-the-address-your-proxy-arrives-from
NINEVEH_FORWARDED_ALLOW_IPS=127.0.0.1

# Lets the admin UI exit the process so Docker's restart policy brings it back
# with newly saved settings. Turn it off if nothing supervises the container.
NINEVEH_RESTART_ENABLED=true

# Container memory ceiling. Nineveh idles around 80-120 MB. This one is enforced
# by Docker at container-creation time, so changing it needs `up -d`, not the
# in-app restart. Admin > Settings shows the ceiling it detects.
NINEVEH_MEMORY_LIMIT=1g

# Everything else -- service title, scan interval, feed and page-range sizes,
# cache budgets, worker counts and the image-pixel ceiling -- is edited in
# Admin > Settings and stored in the state database. Deliberately not repeated
# here: two sources of truth for one value is how deployments end up
# disagreeing with themselves.
