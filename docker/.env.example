# Absolute NAS paths. The data path contains the library directories.
NINEVEH_DATA_PATH=/volume1/media/nineveh
NINEVEH_STATE_PATH=/volume1/docker/nineveh/state
NINEVEH_SECRETS_PATH=/volume1/docker/nineveh/secrets

# More media roots are bind mounts you add in compose.yaml, at a stable
# container path, and then register by that container path in Admin >
# Libraries. Nineveh cannot create a bind mount itself, so a genuinely new
# disk means editing compose.yaml and recreating the service.
#NINEVEH_ARCHIVE_PATH=/volume2/media/archive

# Use the UID/GID that owns the state directory and can read the media
# directory. It needs write access to media only where the librarian agent
# places new volumes.
NINEVEH_PUID=1026
NINEVEH_PGID=100
# Read-only unless this library is where the librarian places volumes; then
# set `rw` (and keep "Allow librarian ingest" on for it in Admin > Libraries).
NINEVEH_DATA_MODE=ro

# The host port, published on loopback only: the reverse proxy and Tailscale
# Serve connect to 127.0.0.1:${NINEVEH_PORT}.
NINEVEH_PORT=8080
NINEVEH_ADMIN_USERNAME=admin
NINEVEH_ADMIN_PASSWORD_FILE=/run/secrets/admin_password.txt
NINEVEH_SECURE_COOKIES=true

# The origin browsers and OPDS clients actually reach, scheme included. Every
# OPDS link is stamped with it, and browser logins are only accepted from it.
# Behind a reverse proxy this is not optional: the proxy terminates TLS, so
# Nineveh cannot infer the https:// origin on its own and both feed links and
# sign-in break. Deployment-owned and not editable in the admin UI, because a
# wrong value locks you out of the page that would fix it.
NINEVEH_PUBLIC_BASE_URL=https://nineveh.example.com

# Split access. Naming any private origin makes the public origin reader-only:
# administrator accounts, the admin pages, the API docs and the librarian API
# answer only on these origins, and only to clients from the networks below.
# List every way you administer the NAS -- a Tailscale Serve name, a LAN
# address behind the DSM reverse proxy -- comma-separated, https only.
NINEVEH_PRIVATE_BASE_URLS=https://nas.your-tailnet.ts.net,https://192.168.1.10:5443
# Client networks allowed on those origins: Tailscale's ranges, plus your LAN.
NINEVEH_PRIVATE_ALLOW_IPS=100.64.0.0/10,fd7a:115c:a1e0::/48,192.168.1.0/24

# Peers whose X-Forwarded-* headers are believed; accepts an address, a
# comma-separated list, or CIDR. Docker's port mapping rewrites the source
# address, so a DSM proxy pointed at 127.0.0.1:8080 does NOT arrive from
# 127.0.0.1 and this default silently discards its X-Forwarded-Proto.
# Do not guess the subnet -- Compose uses its own network, not the default
# bridge. The deployment guide shows how to read the real address:
# docker/synology-deployment.md#finding-the-address-your-proxy-arrives-from
NINEVEH_FORWARDED_ALLOW_IPS=127.0.0.1

# Lets the admin UI exit the process so Docker's restart policy brings it back
# with newly saved settings. Turn it off if nothing supervises the container.
NINEVEH_RESTART_ENABLED=true

# Container memory ceiling. Nineveh idles around 80-120 MB. This one is enforced
# by Docker at container-creation time, so changing it needs `up -d`, not the
# in-app restart. Admin > Settings shows the ceiling it detects.
NINEVEH_MEMORY_LIMIT=1g

# Container CPU ceiling, in cores; 0 leaves it out. Off here because many
# Synology kernels cannot enforce a CPU cap, and Docker then refuses to create
# the container at all ("NanoCPUs can not be set ... CPU CFS scheduler")
# rather than run it uncapped. If `docker info` prints no "No cpu cfs quota
# support" warning, the kernel can: set this to at most your core count, e.g.
# 2.0. Like the memory ceiling, changing it needs `up -d`.
NINEVEH_CPU_LIMIT=0

# Fair use. Past these ceilings a request waits its turn -- each account gets
# an even share -- and only a runaway backlog is refused with 429.
#NINEVEH_DOWNLOAD_STREAMS=16
#NINEVEH_DOWNLOAD_STREAMS_PER_ACCOUNT=4
#NINEVEH_RANGE_WORKERS=1
#NINEVEH_ACCOUNT_REQUESTS_PER_MINUTE=6000

# Storage ceilings. The reserve is disk that uploads and generated page
# ranges may never use, so the database always has room to write.
#NINEVEH_STATE_FREE_RESERVE_BYTES=536870912
#NINEVEH_MAX_RANGE_UNCOMPRESSED_BYTES=536870912
#NINEVEH_STAGING_MAX_PER_TOKEN=10
#NINEVEH_STAGING_MAX_BYTES_PER_TOKEN=21474836480

# Decode library pages in a memory- and CPU-limited worker process too.
# Downloaded metadata covers always are. Costs latency on every cold render.
#NINEVEH_ISOLATE_MEDIA_PROCESSING=false

# Everything else -- service title, scan interval, feed and page-range sizes,
# cache budgets, worker counts, the image-pixel ceiling and the MangaBaka
# request limit -- is edited in Admin > Settings and stored in the state
# database. Deliberately not repeated here: two sources of truth for one value
# is how deployments end up disagreeing with themselves.
