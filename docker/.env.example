# Absolute NAS paths. The data path contains the library directories.
NINEVEH_DATA_PATH=/volume1/media/nineveh
NINEVEH_STATE_PATH=/volume1/docker/nineveh/state
NINEVEH_SECRETS_PATH=/volume1/docker/nineveh/secrets

# Use the UID/GID that owns the state directory and can read the media directory.
NINEVEH_PUID=1026
NINEVEH_PGID=100

NINEVEH_PORT=8080
NINEVEH_TITLE=Nineveh
NINEVEH_PUBLIC_BASE_URL=https://nineveh.example.com
NINEVEH_ADMIN_USERNAME=admin
NINEVEH_ADMIN_PASSWORD_FILE=/run/secrets/admin_password.txt
NINEVEH_SECURE_COOKIES=true
NINEVEH_SCAN_INTERVAL_SECONDS=900
NINEVEH_ARCHIVE_CACHE_SIZE=4
NINEVEH_THUMBNAIL_CACHE_MB=512
NINEVEH_PAGE_CACHE_MB=1024

# Concurrency ceilings. Each hash worker holds ~19 MiB while verifying a password;
# each extract worker streams one page into the cache. Raise both on a NAS with
# spare cores and memory.
NINEVEH_HASH_WORKERS=2
NINEVEH_EXTRACT_WORKERS=2

# Largest image Nineveh will decode for a cover. Decoding costs ~3 bytes/pixel,
# so this is the service's only sizeable memory spike.
NINEVEH_MAX_IMAGE_PIXELS=200000000

# Container memory ceiling. Nineveh idles around 80-120 MB.
NINEVEH_MEMORY_LIMIT=1g

# Restrict this to the reverse proxy address or subnet when known.
NINEVEH_FORWARDED_ALLOW_IPS=127.0.0.1
