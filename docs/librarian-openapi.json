  "info": {
    "description": "An authenticated OPDS 2.0 service for CBZ libraries.",
    "title": "Nineveh (librarian)",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/librarian/ingest": {
      "get": {
        "description": "What is waiting for a commit \u2014 the approve-at-the-desk queue.",
        "operationId": "librarian_ingest_pending_api_v1_librarian_ingest_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingIngests"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "LibrarianToken": []
          }
        ],
        "summary": "Librarian Ingest Pending",
        "tags": [
          "librarian"
        ]
      },
      "post": {
        "operationId": "librarian_ingest_stage_api_v1_librarian_ingest_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_librarian_ingest_stage_api_v1_librarian_ingest_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StagedIngest"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "LibrarianToken": []
          }
        ],
        "summary": "Librarian Ingest Stage",
        "tags": [
          "librarian"
        ]
      }
    },
